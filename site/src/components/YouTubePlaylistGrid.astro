---
interface Props {
	playlistId: string;
	limit?: number;
	fallbackText?: string;
}

const {
	playlistId,
	limit = 3,
	fallbackText = 'Latest playlist videos are temporarily unavailable.'
} = Astro.props;

const playlistFeedUrl = `https://www.youtube.com/feeds/videos.xml?playlist_id=${playlistId}`;

const decodeXml = (value: string) =>
	value
		.replace(/&amp;/g, '&')
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'");

type PlaylistVideo = {
	videoId: string;
	title: string;
};

let videos: PlaylistVideo[] = [];
const embedParams = 'rel=0&modestbranding=1&iv_load_policy=3&fs=0&playsinline=1';

try {
	const response = await fetch(playlistFeedUrl);
	if (response.ok) {
		const xml = await response.text();
		const entries = [...xml.matchAll(/<entry>([\s\S]*?)<\/entry>/g)].map((match) => match[1]);

		videos = entries
			.slice(0, limit)
			.map((entry) => {
				const videoIdMatch = entry.match(/<yt:videoId>([^<]+)<\/yt:videoId>/);
				const titleMatch = entry.match(/<title>([\s\S]*?)<\/title>/);

				if (!videoIdMatch) return null;

				return {
					videoId: videoIdMatch[1],
					title: decodeXml(titleMatch?.[1] ?? 'YouTube video')
				};
			})
			.filter((video): video is PlaylistVideo => video !== null);
	}
} catch {
	videos = [];
}
---

{videos.length > 0 ? (
	<div class="yt-playlist-grid">
		{videos.map((video) => (
			<article class="yt-embed-card">
				<div class="yt-embed-wrap">
					<iframe
						src={`https://www.youtube-nocookie.com/embed/${video.videoId}?${embedParams}`}
						title={video.title}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					></iframe>
				</div>
				<p>{video.title}</p>
			</article>
		))}
	</div>
) : (
	<p class="yt-feed-fallback">{fallbackText}</p>
)}

<style>
	.yt-playlist-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin-top: 26px;
	}

	.yt-embed-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.yt-embed-wrap {
		position: relative;
		padding-top: 56.25%;
		background: #0f172a;
		border: 1px solid rgba(0, 0, 0, 0.08);
	}

	.yt-embed-wrap iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.yt-embed-card p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.45;
		color: #6b7280;
	}

	.yt-feed-fallback {
		margin-top: 18px;
		font-size: 0.95rem;
		color: #6b7280;
	}

	@media (max-width: 820px) {
		.yt-playlist-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
