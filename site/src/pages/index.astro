---
import Layout from '../layouts/Layout.astro';

const featureCards = [
	{
		title: 'Project Videos',
		description:
			'Follow practical builds, reviews and workshop experiments covering PCs, electronics and maker projects.',
		cta: 'Watch videos',
		href: 'https://www.youtube.com/@KingTechNL'
	},
	{
		title: 'Technical Blogs',
		description:
			'Read approachable write-ups, how-to content and engineering notes on hardware and software topics.',
		cta: 'Read blogs',
		href: '/blogs'
	},
	{
		title: 'About KingTech',
		description:
			'Explore the mission behind KingTech: sharing knowledge, testing new ideas and helping others build confidently.',
		cta: 'About us',
		href: '/aboutus'
	}
];

const highlightStats = [
	{ value: '10+', label: 'years exploring technology' },
	{ value: '3', label: 'core focus areas: hardware, software, maker culture' },
	{ value: '100%', label: 'hands-on, experiment-driven learning' }
];
---

<Layout
	title="KingTech | Discover, Build, Share"
	description="KingTech shares practical tech knowledge through videos, blogs and hands-on project stories."
>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="/">
				<span class="brand-mark">K</span>
				<span class="brand-text">KingTech</span>
			</a>

			<nav class="site-nav" aria-label="Main navigation">
				<a href="/videos">Videos</a>
				<a href="/blogs">Blogs</a>
				<a href="/aboutus">About us</a>
				<a class="nav-button" href="#contact">Contact</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Tech stories, builds and practical guides</p>
					<h1>Exploring hardware, software and creative engineering.</h1>
					<p class="hero-text">
						KingTech is a modern technical platform focused on learning by building. From PC
						projects and electronics to software experiments and tutorials, the goal is to make
						complex technology approachable and inspiring.
					</p>

					<div class="hero-actions">
						<a class="primary-button" href="/blogs">Explore articles</a>
						<a class="secondary-button" href="https://www.youtube.com/@KingTechNL"
							>Visit YouTube</a
						>
					</div>

					<ul class="stats-list">
						{highlightStats.map((stat) => (
							<li>
								<strong>{stat.value}</strong>
								<span>{stat.label}</span>
							</li>
						))}
					</ul>
				</div>

				<div class="hero-panel">
					<div class="panel-glow"></div>
					<div class="panel-card panel-card-large">
						<span class="panel-kicker">Featured focus</span>
						<h2>Build. Test. Explain.</h2>
						<p>
							A clean, editorial landing page inspired by the current KingTech site, with a darker
							premium look, bold call-to-actions and clear content sections.
						</p>
					</div>
					<div class="panel-grid">
						<div class="panel-card small accent-red">
							<span>Hardware</span>
							<p>PCs, upgrades, devices and workshop builds.</p>
						</div>
						<div class="panel-card small accent-blue">
							<span>Software</span>
							<p>Apps, integrations, tools and development guides.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="intro-block">
				<div>
					<p class="section-label">What KingTech is about</p>
					<h2>Technology is better when it is explained clearly and shared openly.</h2>
				</div>
				<p>
					The site is structured around discovery, practical knowledge and experimentation. The
					visual design uses a dark base, subtle gradients, strong typography and modular content
					cards to reflect a polished, tech-focused brand.
				</p>
			</section>

			<section class="feature-section">
				<div class="section-heading">
					<p class="section-label">Core sections</p>
					<h2>Designed for content, community and hands-on learning.</h2>
				</div>

				<div class="feature-grid">
					{featureCards.map((card) => (
						<article class="feature-card">
							<div class="feature-icon" aria-hidden="true">●</div>
							<h3>{card.title}</h3>
							<p>{card.description}</p>
							<a href={card.href}>{card.cta}</a>
						</article>
					))}
				</div>
			</section>

			<section class="showcase-grid">
				<article class="showcase-card showcase-primary">
					<p class="section-label">Content style</p>
					<h2>Balanced between visual storytelling and technical depth.</h2>
					<p>
						Use this space for featured projects, recent launches or a curated content stream that
						pulls users deeper into the platform.
					</p>
				</article>

				<article class="showcase-card">
					<h3>Videos</h3>
					<p>Prominent visual entry point for project showcases and quick explanations.</p>
				</article>

				<article class="showcase-card">
					<h3>Blogs</h3>
					<p>Detailed written follow-up content for users who want a deeper technical breakdown.</p>
				</article>

				<article class="showcase-card">
					<h3>Community value</h3>
					<p>Strong messaging around learning, experimenting and building things yourself.</p>
				</article>
			</section>

			<section class="cta-banner" id="contact">
				<div>
					<p class="section-label">Get in touch</p>
					<h2>Want to collaborate, share an idea or follow along with new projects?</h2>
				</div>
				<a class="primary-button" href="mailto:info@example.nl">Contact KingTech</a>
			</section>
		</main>

		<footer class="site-footer">
			<p>© KingTech 2012–2026. All rights reserved.</p>
			<div class="footer-links">
				<a href="https://www.youtube.com/@KingTechNL">YouTube</a>
				<a href="https://github.com/KingTechNL">GitHub</a>
				<a href="https://hub.docker.com/u/kingtechnl">Docker Hub</a>
				<a href="https://www.nuget.org/profiles/Kingtech">NuGet</a>
			</div>
		</footer>
	</div>
</Layout>

<style>
	:root {
		color-scheme: dark;
		--bg: #050816;
		--bg-soft: rgba(16, 23, 46, 0.92);
		--panel: rgba(14, 20, 38, 0.88);
		--panel-strong: rgba(18, 27, 49, 0.96);
		--line: rgba(255, 255, 255, 0.08);
		--text: #f4f7fb;
		--muted: #a6b3ca;
		--primary: #5f7cff;
		--secondary: #ff5d73;
		--glow: radial-gradient(circle at top, rgba(95, 124, 255, 0.35), transparent 48%),
			radial-gradient(circle at bottom right, rgba(255, 93, 115, 0.22), transparent 30%);
	}

	:global(body) {
		font-family: Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
		background:
			var(--glow),
			linear-gradient(180deg, #08101f 0%, #050816 55%, #04060f 100%);
		color: var(--text);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.page-shell {
		max-width: 1240px;
		margin: 0 auto;
		padding: 24px;
	}

	.site-header,
	.site-footer,
	.hero,
	.intro-block,
	.feature-section,
	.showcase-grid,
	.cta-banner {
		position: relative;
		z-index: 1;
	}

	.site-header,
	.site-footer,
	.intro-block,
	.cta-banner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
	}

	.site-header {
		padding: 8px 0 28px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.brand-mark {
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		border-radius: 14px;
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		box-shadow: 0 18px 36px rgba(56, 87, 214, 0.28);
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 20px;
		color: var(--muted);
	}

	.site-nav a:hover,
	.footer-links a:hover,
	.feature-card a:hover {
		color: var(--text);
	}

	.nav-button,
	.primary-button,
	.secondary-button,
	.feature-card a {
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.nav-button,
	.primary-button,
	.secondary-button {
		padding: 12px 18px;
		border-radius: 999px;
		border: 1px solid transparent;
		font-weight: 600;
	}

	.nav-button,
	.secondary-button {
		background: rgba(255, 255, 255, 0.04);
		border-color: var(--line);
	}

	.primary-button {
		background: linear-gradient(135deg, var(--primary), var(--secondary));
		box-shadow: 0 16px 36px rgba(78, 103, 240, 0.25);
	}

	.nav-button:hover,
	.primary-button:hover,
	.secondary-button:hover,
	.feature-card a:hover {
		transform: translateY(-1px);
	}

	.hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 28px;
		padding: 28px 0 42px;
	}

	.hero-copy,
	.hero-panel,
	.intro-block,
	.feature-card,
	.showcase-card,
	.cta-banner {
		border: 1px solid var(--line);
		background: linear-gradient(180deg, rgba(18, 25, 46, 0.86), rgba(8, 12, 24, 0.96));
		backdrop-filter: blur(14px);
		border-radius: 28px;
	}

	.hero-copy {
		padding: 48px;
	}

	.eyebrow,
	.section-label,
	.panel-kicker {
		margin: 0 0 14px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		font-size: 0.78rem;
		color: #8aa1ff;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		font-size: clamp(2.8rem, 5vw, 5rem);
		line-height: 1.02;
		max-width: 11ch;
		margin-bottom: 20px;
	}

	h2 {
		font-size: clamp(1.7rem, 3vw, 2.75rem);
		line-height: 1.1;
		margin-bottom: 16px;
	}

	.hero-text,
	.intro-block p,
	.feature-card p,
	.showcase-card p,
	.cta-banner p,
	.site-footer p,
	.panel-card p {
		color: var(--muted);
		line-height: 1.75;
	}

	.hero-actions {
		display: flex;
		gap: 14px;
		margin: 32px 0;
		flex-wrap: wrap;
	}

	.stats-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.stats-list li {
		padding: 18px;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.05);
	}

	.stats-list strong {
		display: block;
		font-size: 1.6rem;
		margin-bottom: 8px;
	}

	.stats-list span {
		color: var(--muted);
		font-size: 0.95rem;
	}

	.hero-panel {
		padding: 26px;
		overflow: hidden;
	}

	.panel-glow {
		position: absolute;
		inset: -20% auto auto 30%;
		width: 320px;
		height: 320px;
		background: radial-gradient(circle, rgba(95, 124, 255, 0.22), transparent 60%);
		pointer-events: none;
	}

	.panel-card {
		position: relative;
		border-radius: 24px;
		border: 1px solid rgba(255, 255, 255, 0.07);
		background: var(--panel);
	}

	.panel-card-large {
		padding: 32px;
		min-height: 260px;
		margin-bottom: 18px;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
	}

	.panel-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}

	.panel-card.small {
		padding: 22px;
	}

	.panel-card.small span {
		display: inline-block;
		font-weight: 700;
		margin-bottom: 8px;
	}

	.accent-red {
		box-shadow: inset 0 0 0 1px rgba(255, 93, 115, 0.12);
	}

	.accent-blue {
		box-shadow: inset 0 0 0 1px rgba(95, 124, 255, 0.12);
	}

	.intro-block,
	.cta-banner {
		padding: 32px;
		margin: 18px 0 28px;
	}

	.intro-block > * {
		flex: 1;
	}

	.feature-section {
		padding: 12px 0 10px;
	}

	.section-heading {
		max-width: 760px;
		margin-bottom: 24px;
	}

	.feature-grid,
	.showcase-grid {
		display: grid;
		gap: 20px;
	}

	.feature-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.feature-card,
	.showcase-card {
		padding: 28px;
	}

	.feature-icon {
		font-size: 1.3rem;
		color: var(--secondary);
		margin-bottom: 14px;
	}

	.feature-card h3,
	.showcase-card h3 {
		font-size: 1.35rem;
		margin-bottom: 12px;
	}

	.feature-card a {
		display: inline-flex;
		margin-top: 20px;
		color: #b8c7ff;
		font-weight: 600;
	}

	.showcase-grid {
		grid-template-columns: 1.2fr repeat(3, 1fr);
		margin: 26px 0;
	}

	.showcase-primary {
		background:
			radial-gradient(circle at top right, rgba(255, 93, 115, 0.16), transparent 34%),
			linear-gradient(180deg, rgba(18, 27, 49, 0.96), rgba(9, 13, 24, 0.98));
	}

	.site-footer {
		padding: 30px 0 12px;
		color: var(--muted);
	}

	.footer-links {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	@media (max-width: 1080px) {
		.hero,
		.showcase-grid,
		.feature-grid {
			grid-template-columns: 1fr;
		}

		.stats-list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 820px) {
		.page-shell {
			padding: 18px;
		}

		.site-header,
		.intro-block,
		.cta-banner,
		.site-footer {
			flex-direction: column;
			align-items: flex-start;
		}

		.site-nav,
		.panel-grid {
			width: 100%;
		}

		.site-nav {
			flex-wrap: wrap;
			gap: 12px;
		}

		.hero-copy,
		.hero-panel,
		.intro-block,
		.feature-card,
		.showcase-card,
		.cta-banner {
			padding: 24px;
		}

		h1 {
			max-width: none;
		}
	}
</style>
