---
import Layout from '../layouts/Layout.astro';
import '../styles/index.css';
import '../styles/blogs.css';

const ggvCards = [
	{
		title: 'Gijs Grote Tuinverbouwing',
		image: '/blogs/ggtv-banner.png',
		description:
			'In Gijs Grote Tuinverbouwing we take you into the wonderful world of gardening. Presenter Gijs van der Meijde explains how he transformed his garden from a refined schoolyard into a true oasis of tranquility.',
		nlHref: 'https://ggv.kingtech.nl/GijsGroteTuinverbouwing/',
		enHref: 'https://ggv.kingtech.nl/en/GijsGroteTuinverbouwing/'
	},
	{
		title: 'Gijs Grote Garageverbouwing',
		image: '/blogs/gggv-banner.png',
		description:
			'After the overwhelming success of Tuinverbouwing, Gijs takes you on a new DIY adventure. In Gijs Grote Garageverbouwing he exchanges nature for a real man cave and shares practical build steps along the way.',
		nlHref: 'https://ggv.kingtech.nl/GijsGroteGarageverbouwing/',
		enHref: 'https://ggv.kingtech.nl/en/GijsGroteGarageverbouwing/'
	},
	{
		title: 'Gijs Grote Vleesverbouwing',
		image: '/blogs/ggvv-banner.png',
		description:
			'After hitting another homerun with Garageverbouwing, it is time to embark on a culinary adventure. In Gijs Grote Vleesverbouwing, presenter Gijs van der Meijde will show you how to get the most out of your barbeque.',
		nlHref: 'https://ggv.kingtech.nl/GijsGroteGarageverbouwing/',
		enHref: 'https://ggv.kingtech.nl/en/GijsGroteGarageverbouwing/'
	}
];
---

<Layout
	title="KingTech | Blogs"
	description="KingTech blog posts about hardware, software, and maker projects."
>
	<div class="page-shell">
		<main>
			<section class="ggv-intro intro-block intro-accent-card">
				<div>
					<h1>Gijs Grote Verbouwing</h1>
					<p>
						In the Gijs Grote Verbouwing blog series, KingTech founder Gijs shows off his latest
						personal projects and sprinkles them with a healthy load of satire. It started out as a
						joke, whenever people asked Gijs how his garden was coming along, Gijs would send them a
						link to <a href="https://ggv.kingtech.nl/" target="_blank" rel="noopener noreferrer">Gijs Grote Tuinverbouwing</a>
						(Gijs Great Garden Makeover). Later he did the same for his garage, the new KingTech
						office. Because of the popularity of the blogs, Gijs keeps maintaining and expanding them
						whenever there are new updates.
					</p>
				</div>
			</section>

			<section class="ggv-grid">
				{ggvCards.map((card) => (
					<article class="ggv-card media-card">
						<img src={card.image} alt={card.title} />
						<div class="media-card-body ggv-card-body">
							<p>{card.description}</p>
							<p class="ggv-languages">
								<a href={card.nlHref} target="_blank" rel="noopener noreferrer">NL</a>
								<span>|</span>
								{card.enHref ? (
									<a href={card.enHref} target="_blank" rel="noopener noreferrer">EN</a>
								) : (
									<span>EN (coming soon)</span>
								)}
							</p>
						</div>
					</article>
				))}
			</section>
		</main>

	</div>
</Layout>
